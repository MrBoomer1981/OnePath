# Copy to .env and fill in.

# DeepSeek API key: https://platform.deepseek.com/api_keys (the radar reads announcements with DeepSeek Flash)
DEEPSEEK_API_KEY=

# The weekly web search for opportunities (my_browser/news/discover.py): the local SearXNG started with
# `docker compose up -d`, or Tavily (on Railway, where there is no SearXNG; its key switches to it by itself)
SEARX_URL=http://localhost:8080
# Generate with: openssl rand -hex 32
SEARXNG_SECRET=
# WEB_RETRIEVER=tavily
# TAVILY_API_KEY=

# Web app (uv run app.py): password; required when it listens publicly (Railway)
APP_PASSWORD=

# DEEper's address (its phone proxy): «Исследовать» on an opportunity opens a research of it there.
# Unset, the button is not shown. Keep the address out of the repository: it is a Railway variable.
# RESEARCH_URL=

# The radar's loop polls the sources every few minutes inside uv run app.py; NEWS_LOOP=0 keeps it off there
# (for example in a second local copy). NEWS_MODELS_DIR: where the embedding model (220 MB) is kept.
# NEWS_LOOP=0
# NEWS_MODELS_DIR=

# The parts run in one process by default (uv run app.py). When the radar runs separately
# (python -m my_browser.news), tell core where it is and share one token:
# NEWS_URL=http://127.0.0.1:8504
# SERVICE_TOKEN=
